{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "ink": "#0e0920",
    "ink2": "#0f1637",
    "brandBlue": "#3a90df",
    "brandIndigo": "#7364df",
    "brandViolet": "#ac38df",
    "muted": "#C9CCE0",
    "light": "#F7F8F9",
    "danger": "#ff8f98",
    "success": "#4ade80",
    "warn": "#fbbf24",
    "panel": "#1a1440",
    "element": "#241c52",
    "border": "#4a5075"
  },
  "theme": {
    "primary": { "dark": "brandIndigo", "light": "brandIndigo" },
    "secondary": { "dark": "brandBlue", "light": "brandBlue" },
    "accent": { "dark": "brandViolet", "light": "brandViolet" },
    "error": { "dark": "danger", "light": "danger" },
    "warning": { "dark": "warn", "light": "warn" },
    "success": { "dark": "success", "light": "success" },
    "info": { "dark": "brandBlue", "light": "brandBlue" },
    "text": { "dark": "light", "light": "ink" },
    "textMuted": { "dark": "muted", "light": "border" },
    "background": { "dark": "ink", "light": "light" },
    "backgroundPanel": { "dark": "ink2", "light": "#eef0f6" },
    "backgroundElement": { "dark": "panel", "light": "#e4e7f2" },
    "border": { "dark": "border", "light": "#d5d9e6" },
    "borderActive": { "dark": "brandIndigo", "light": "brandIndigo" },
    "borderSubtle": { "dark": "element", "light": "#d5d9e6" },
    "diffAdded": { "dark": "success", "light": "success" },
    "diffRemoved": { "dark": "danger", "light": "danger" },
    "diffContext": { "dark": "muted", "light": "border" },
    "diffHunkHeader": { "dark": "muted", "light": "border" },
    "diffHighlightAdded": { "dark": "success", "light": "success" },
    "diffHighlightRemoved": { "dark": "danger", "light": "danger" },
    "diffAddedBg": { "dark": "element", "light": "#e5e9f0" },
    "diffRemovedBg": { "dark": "element", "light": "#e5e9f0" },
    "diffContextBg": { "dark": "panel", "light": "#eef0f6" },
    "diffLineNumber": { "dark": "border", "light": "muted" },
    "diffAddedLineNumberBg": { "dark": "element", "light": "#e5e9f0" },
    "diffRemovedLineNumberBg": { "dark": "element", "light": "#e5e9f0" },
    "markdownText": { "dark": "light", "light": "ink" },
    "markdownHeading": { "dark": "brandIndigo", "light": "brandIndigo" },
    "markdownLink": { "dark": "brandBlue", "light": "brandBlue" },
    "markdownLinkText": { "dark": "brandViolet", "light": "brandViolet" },
    "markdownCode": { "dark": "success", "light": "#16803a" },
    "markdownBlockQuote": { "dark": "muted", "light": "border" },
    "markdownEmph": { "dark": "warn", "light": "#a16207" },
    "markdownStrong": { "dark": "brandViolet", "light": "brandViolet" },
    "markdownHorizontalRule": { "dark": "border", "light": "#d5d9e6" },
    "markdownListItem": { "dark": "brandBlue", "light": "brandBlue" },
    "markdownListEnumeration": { "dark": "brandIndigo", "light": "brandIndigo" },
    "markdownImage": { "dark": "brandBlue", "light": "brandBlue" },
    "markdownImageText": { "dark": "brandViolet", "light": "brandViolet" },
    "markdownCodeBlock": { "dark": "light", "light": "ink" },
    "syntaxComment": { "dark": "muted", "light": "border" },
    "syntaxKeyword": { "dark": "brandIndigo", "light": "brandIndigo" },
    "syntaxFunction": { "dark": "brandBlue", "light": "brandBlue" },
    "syntaxVariable": { "dark": "brandViolet", "light": "brandViolet" },
    "syntaxString": { "dark": "success", "light": "#16803a" },
    "syntaxNumber": { "dark": "warn", "light": "#a16207" },
    "syntaxType": { "dark": "brandViolet", "light": "brandViolet" },
    "syntaxOperator": { "dark": "brandIndigo", "light": "brandIndigo" },
    "syntaxPunctuation": { "dark": "light", "light": "ink" }
  }
}
